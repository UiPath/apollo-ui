  "guardrails.definitions.prompt_injection.display-name": "提示词注入",
  "guardrails.definitions.prompt_injection.description": "此验证程序由 Noma Security 提供，旨在检测 LLM 调用中的恶意攻击企图（例如提示词注入、越狱攻击）。",
  "guardrails.definitions.prompt_injection.param.threshold.label": "检测阈值",
  "guardrails.definitions.prompt_injection.param.threshold.tooltip": "介于 0 和 1 之间的值。提示词注入检测的敏感度级别。阈值越高，可检测到的潜在提示词注入就越多，但可能会导致更多的误报。",
  "guardrails.definitions.harmful_content.display-name": "有害内容",
  "guardrails.definitions.harmful_content.description": "使用 Azure AI 内容安全检测有害内容（例如仇恨、暴力）。",
  "guardrails.definitions.harmful_content.param.harmfulContentEntities.label": "内容类别",
  "guardrails.definitions.harmful_content.param.harmfulContentEntityThresholds.label": "严重性阈值",
  "guardrails.definitions.harmful_content.param.harmfulContentEntityThresholds.tooltip": "介于 0 到 6 之间的整数值（第 2 步）。有害内容检测的严重性阈值。数值越高，触发所需的内容严重程度就越高。",
  "guardrails.definitions.harmful_content.option.harmfulContentEntities.Hate": "仇恨",
  "guardrails.definitions.harmful_content.option.harmfulContentEntities.SelfHarm": "自残",
  "guardrails.definitions.harmful_content.option.harmfulContentEntities.Sexual": "色情",
  "guardrails.definitions.harmful_content.option.harmfulContentEntities.Violence": "暴力",
  "guardrails.definitions.user_prompt_attacks.display-name": "用户提示攻击",
  "guardrails.definitions.user_prompt_attacks.description": "使用 Azure AI 内容安全检测试图绕过系统指令的用户提示攻击。",
  "guardrails.definitions.intellectual_property.display-name": "知识产权",
  "guardrails.definitions.intellectual_property.description": "使用 Azure AI 内容安全检测文本和代码中潜在的知识产权侵犯行为。",
  "guardrails.definitions.intellectual_property.param.ipEntities.label": "内容类型",
  "guardrails.definitions.intellectual_property.option.ipEntities.Text": "文本",
  "guardrails.definitions.intellectual_property.option.ipEntities.Code": "代码",
  "guardrails.definitions.llm_as_judge.display-name": "LLM 作为评判器",
  "guardrails.definitions.llm_as_judge.description": "使用 LLM 作为评判器检测您定义的规则违规行为。",
  "guardrails.definitions.llm_as_judge.usage-note": "评判模型调用与智能体自身的 LLM 调用一样，会消耗 Agent Unit。请有选择地使用以保持成本可预测，并在选择评判模型时考虑成本 — 不同模型的费率不同。",
  "guardrails.definitions.llm_as_judge.param.guardrailText.label": "规则提示词",
  "guardrails.definitions.llm_as_judge.param.model.label": "评判模型",
  "guardrails.definitions.llm_as_judge.param.positiveExamples.label": "正面示例",
  "guardrails.definitions.llm_as_judge.param.negativeExamples.label": "负面示例",
  "guardrails.definitions.llm_as_judge.param.threshold.label": "严格程度",
  "guardrails.definitions.llm_as_judge.param.guardrailText.tooltip": "描述评判器将执行的规则。请具体说明哪些应通过、哪些应失败。",
  "guardrails.definitions.llm_as_judge.param.model.tooltip": "用于根据每个负载评估策略的模型。",
  "guardrails.definitions.llm_as_judge.param.positiveExamples.tooltip": "应该通过策略的可选负载。评判器将其用作校准锚点。",
  "guardrails.definitions.llm_as_judge.param.negativeExamples.tooltip": "应该违反策略的可选负载。评判器将其用作校准锚点。",
  "guardrails.definitions.llm_as_judge.param.threshold.tooltip": "严格程度分为 0–6 级。数值越低越严格 — 评判器会标记任何暗示违规的内容。数值越高越宽松 — 仅标记明确、无歧义的违规行为。",
  "guardrails.definitions.sentiment.display-name": "情感",
  "guardrails.definitions.sentiment.description": "此验证器由 Microsoft Azure AI 语言提供，用于检测 LLM 调用中文本的情绪，从而可以拦截已配置的语气。",
  "guardrails.definitions.sentiment.param.sentiments.label": "情感",
  "guardrails.definitions.sentiment.param.sentimentThresholds.label": "置信度阈值",
  "guardrails.definitions.sentiment.param.language.label": "语言",
  "guardrails.definitions.sentiment.param.sentiments.tooltip": "当检测到的情感为以下任一项时，将触发护栏。混合没有置信度分数，因此选择该项时仅依据标签触发，并忽略其阈值。",
  "guardrails.definitions.sentiment.param.sentimentThresholds.tooltip": "所选情感触发护栏所需的最低置信度，范围为 0 到 1。“混合”的阈值不起作用。",
  "guardrails.definitions.sentiment.param.language.tooltip": "对文本进行评分时所采用的语言。指定一种语言时直接使用该语言；列出多种语言时会先检测语言，这会使对 Azure 的调用次数增加一倍。",
  "guardrails.definitions.sentiment.option.sentiments.Positive": "正",
  "guardrails.definitions.sentiment.option.sentiments.Neutral": "一般",
  "guardrails.definitions.sentiment.option.sentiments.Negative": "负",
  "guardrails.definitions.sentiment.option.sentiments.Mixed": "混合式",
