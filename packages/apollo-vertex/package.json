{
  "name": "@uipath/apollo-vertex",
  "version": "0.1.0",
  "description": "UiPath Apollo Vertex design system. Import primitives from the package root.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./dist/theme.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js",
      "require": "./dist/shell/index.cjs"
    },
    "./solution-tests": {
      "types": "./dist/solution-tests/index.d.ts",
      "import": "./dist/solution-tests/index.js",
      "require": "./dist/solution-tests/index.cjs"
    },
    "./feature-flags": {
      "types": "./dist/feature-flags/index.d.ts",
      "import": "./dist/feature-flags/index.js",
      "require": "./dist/feature-flags/index.cjs"
    },
    "./ai-chat": {
      "types": "./dist/ai-chat/index.d.ts",
      "import": "./dist/ai-chat/index.js",
      "require": "./dist/ai-chat/index.cjs"
    },
    "./locales/*": "./dist/locales/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:theme": "node --experimental-strip-types scripts/generate-theme-css.ts",
    "dev": "rslib build --watch",
    "build": "pnpm generate:theme && rslib build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "@tanstack/ai": "^0.14.0",
    "@tanstack/ai-client": "^0.8.0",
