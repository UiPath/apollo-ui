{
  "name": "@uipath/apollo-vertex",
  "version": "0.0.0",
  "description": "UiPath Apollo Vertex design system components",
  "license": "MIT",
  "author": "UiPath",
  "repository": {
    "type": "git",
    "url": "https://github.com/UiPath/apollo-ui.git",
    "directory": "packages/apollo-vertex"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "tailwind",
    "tailwindcss",
    "ui",
    "component-library"
  ],
  "type": "module",
  "main": "./dist/entries/index.js",
  "types": "./dist/entries/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/entries/index.d.ts",
      "default": "./dist/entries/index.js"
    },
    "./charts": {
      "types": "./dist/entries/charts/index.d.ts",
      "default": "./dist/entries/charts/index.js"
    },
    "./shell": {
      "types": "./dist/entries/shell/index.d.ts",
      "default": "./dist/entries/shell/index.js"
    },
    "./shell/entities": {
      "types": "./dist/entries/shell/entities.d.ts",
      "default": "./dist/entries/shell/entities.js"
    },
    "./feature-flags": {
      "types": "./dist/entries/feature-flags/index.d.ts",
      "default": "./dist/entries/feature-flags/index.js"
    },
    "./feature-flags/proteus": {
      "types": "./dist/entries/feature-flags/proteus.d.ts",
      "default": "./dist/entries/feature-flags/proteus.js"
    },
    "./solution-tests": {
      "types": "./dist/entries/solution-tests/index.d.ts",
      "default": "./dist/entries/solution-tests/index.js"
    },
    "./solution-tests/data": {
      "types": "./dist/entries/solution-tests/data.d.ts",
      "default": "./dist/entries/solution-tests/data.js"
    },
    "./ai-chat": {
      "types": "./dist/entries/ai-chat/index.d.ts",
      "default": "./dist/entries/ai-chat/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./locales/*": "./dist/locales/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm generate:theme styles/theme.css && rslib build && node scripts/check-dist.mjs",
    "build:check": "node scripts/check-dist.mjs --list",
    "generate:theme": "node --experimental-strip-types scripts/generate-theme-css.ts",
    "dev": "pnpm generate:theme styles/theme.css && rslib build --watch",
    "clean": "rm -rf dist",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware",
    "lint:deps": "depcruise registry --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
