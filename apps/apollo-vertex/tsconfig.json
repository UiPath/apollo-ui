{
  "extends": "../../packages/apollo-vertex/tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    "../../packages/apollo-vertex/types/*.d.ts",
    "../../packages/apollo-vertex/lib/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
