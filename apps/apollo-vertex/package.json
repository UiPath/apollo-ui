{
  "name": "apollo-vertex",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "dev": "pnpm generate:theme && next --turbopack",
    "build": "pnpm generate:theme && pnpm registry:build && next build",
    "start": "next start",
    "generate:theme": "pnpm --filter @uipath/apollo-vertex generate:theme \"$PWD/app/theme.generated.css\"",
    "registry:build": "shadcn build ../../packages/apollo-vertex/registry.json --cwd ../../packages/apollo-vertex --output \"$PWD/public/r\" && node --experimental-strip-types scripts/generate-registry-index.ts",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "@mantine/hooks": "^9.6.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/ai": "0.14.0",
    "@tanstack/ai-client": "0.8.0",
    "@tanstack/ai-react": "0.8.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-table": "^8.21.3",
    "@uipath/apollo-vertex": "workspace:*",
    "@uipath/uipath-typescript": "^1.8.0",
    "@vercel/analytics": "^1.5.0",
    "framer-motion": "^13.1.0",
    "fumadocs-core": "^16.15.15",
    "fumadocs-mdx": "^15.4.5",
    "fumadocs-ui": "^16.15.15",
    "i18next": "^26.4.2",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.1",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.17",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.38.0",
    "oxlint-tsgolint": "^0.18.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
