{
  "name": "apollo-vertex",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm generate:theme && next --turbopack",
    "build": "pnpm generate:theme && pnpm registry:build && next build",
    "start": "next start",
    "generate:theme": "node --experimental-strip-types scripts/generate-theme-css.ts",
    "registry:build": "shadcn build ../../packages/apollo-vertex/registry.json --cwd ../../packages/apollo-vertex --output \"$PWD/public/r\" && node --experimental-strip-types scripts/generate-registry-index.ts",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --fix --type-aware",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.1.3",
  "dependencies": {
    "@mantine/hooks": "^9.0.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/ai": "0.14.0",
    "@tanstack/ai-client": "0.8.0",
    "@tanstack/ai-react": "0.8.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.132.31",
    "@tanstack/react-table": "^8.21.3",
    "@uipath/apollo-vertex": "workspace:*",
    "@uipath/uipath-typescript": "^1.7.1",
    "@vercel/analytics": "^1.5.0",
    "framer-motion": "^13.1.0",
    "i18next": "^25.8.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.1",
    "next": "16.3.8",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.4",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.17",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react": "^7.37.5",
    "oxlint": "^1.38.0",
    "oxlint-tsgolint": "^0.18.1",
    "pagefind": "^1.4.0",
    "shadcn": "4.4.0",
    "tw-animate-css": "^1.4.0"
  }
