{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../packages/apollo-vertex/.oxlintrc.json"],
  "ignorePatterns": ["scripts/**", "next-env.d.ts", "types/**/*.d.ts"],
  "overrides": [
    {
      "files": ["app/**/layout.tsx", "app/**/page.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["templates/**/*.tsx"],
      "rules": {
        "eslint/max-lines": [
          "error",
          {
            "max": 500
          }
        ]
      }
    }
  ]
}
